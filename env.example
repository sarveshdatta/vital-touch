# Copy to backend/.env and change every value before running.
VT_ADMIN_USERNAME=admin
VT_ADMIN_PASSWORD=choose-a-strong-password
VT_ADMIN_NAME=Dashboard Admin
# Shared secret the ESP32 sends in the X-API-Key header (must match firmware config.h)
VT_DEVICE_API_KEY=change-this-device-key
# Long random string used to sign login sessions
VT_SECRET_KEY=change-this-to-a-long-random-string
VT_DATABASE=vital_touch.db
VT_HOST=0.0.0.0
VT_PORT=5000
# 1 = generate clearly-labelled simulated readings when no hardware is connected
VT_SIMULATE=0
